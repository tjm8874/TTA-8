@echo off
chcp 65001 >nul
echo ============================================================
echo   はじめに 1回だけ : USB ドライバの 設定 [Zadig]
echo ============================================================
echo.
echo  これから Zadig という ツールを 開きます。
echo  「このアプリが変更を加えることを許可しますか」と 出たら「はい」。
echo.
echo  じゅんびが できたら 何か キーを おしてね。
pause >nul
start "" "%~dp0zadig\zadig-2.9.exe"
echo.
echo ------------------------------------------------------------
echo   Zadig が 開いたら、この 手順を 見ながら やってみよう
echo ------------------------------------------------------------
echo.
echo   1. メニューの Options から「List All Devices」に チェック
echo   2. リストから 名前の おわりが「[Interface 0]」で、
echo      下の「USB ID」が「0403 6010 00」に なるものを えらぶ
echo      [れい]「USB Debugger [Interface 0]」
echo      ※ 名前は ちがうことも あるので USB ID で たしかめよう
echo      ※ Interface 1 は えらばないでね [こちらは シリアル通信用]
echo      ※ 見つからない / 「不明な USB デバイス」 しか 出ないときは、
echo        USB ケーブルを べつの ものに かえてみよう [充電専用ケーブルだと 見えない]
echo        または、パソコン本体の USB に 直接 さしてみよう
echo   3. 右がわの ドライバが「WinUSB」に なっているのを 確認
echo   4. 「Replace Driver」 または 「Install Driver」 ボタンを おす
echo   5. 「successfully」と 出たら 完了。Zadig を とじてね
echo.
echo ------------------------------------------------------------
echo   つぎは 1_check_board.bat で ボードが 見えるか たしかめよう。
echo.
echo   だいじょうぶなら 何か キーを おして この画面を とじよう。
echo ------------------------------------------------------------
pause >nul
